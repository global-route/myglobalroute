{
  "name": "global-route",
  "version": "1.0.0",
  "description": "Radical transparency for African mobility and global migration pathways",
  "main": "src/js/app.js",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "build:old": "npm run build:css && npm run build:js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "test": "jest --run",
    "test:watch": "jest --watch",
    "lint": "eslint src/js",
    "format": "prettier --write 'src/**/*.{js,css,html,md}'",
    "deploy": "npm run build && netlify deploy --prod",
    "data:validate": "node scripts/validate-data.js",
    "build:verify": "node scripts/verify-build.js",
    "seo:a11y:verify": "node scripts/verify-seo-a11y.js",
    "verify": "npm run data:validate && npm test -- --runInBand && npm run build && npm run build:verify && npm run seo:a11y:verify && npm run lint"
  },
  "keywords": ["visa", "immigration", "Africa", "global mobility", "student pathways", "work visas"],
  "author": "Global Route Team",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "netlify-cli": "^17.30.0",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  },
  "engines": { "node": ">=18.0.0", "npm": ">=9.0.0" },
  "repository": { "type": "git", "url": "https://github.com/global-route/myglobalroute.git" },
  "bugs": { "url": "https://github.com/global-route/myglobalroute/issues" }
}
