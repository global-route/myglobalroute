{
  "name": "global-route",
  "version": "1.0.0",
  "description": "Radical transparency for African mobility and global migration pathways",
  "main": "src/js/app.js",
  "scripts": {
    "dev": "netlify dev",
    "build": "npm run build:css && npm run build:js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "test": "jest --run",
    "test:watch": "jest --watch",
    "lint": "eslint src/js --fix",
    "format": "prettier --write 'src/**/*.{js,css,html,md}'",
    "deploy": "netlify deploy --prod",
    "data:validate": "node scripts/validate-data.js"
  },
  "keywords": [
    "visa",
    "immigration",
    "Africa",
    "global mobility",
    "student pathways",
    "work visas"
  ],
  "author": "Global Route Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "netlify-cli": "^17.30.0",
    "prettier": "^3.2.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/global-route.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/global-route/issues"
  },
  "homepage": "https://global-route.app"
}
