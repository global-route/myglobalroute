---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script async src="https://www.sabilytics.com/script.js" data-site="atsngkb78nmt" data-domain="org.uk"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | MyPathway2Global</title>
  <meta name="description" content="{{ excerpt or content | excerpt }}">
  <meta name="keywords" content="{{ keywords }}">
  
  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ excerpt or content | excerpt }}">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://mypathway2global.org.uk{{ page.url }}">
  <meta property="og:site_name" content="MyPathway2Global">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ excerpt or content | excerpt }}">
  <meta name="twitter:site" content="@mypathway2globalapp">
  <meta name="twitter:image" content="https://mypathway2global.org.uk/assets/og-default.png">
  <meta name="author" content="MyPathway2Global">
  <meta property="og:image" content="https://mypathway2global.org.uk/assets/og-default.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  
  <link rel="canonical" href="https://mypathway2global.org.uk{{ page.url }}">
  
  <!-- Article Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title }}",
    "description": "{{ excerpt }}",
    "datePublished": "{{ date }}",
    "dateModified": "{{ lastFactChecked or updated or date }}",
    "author": {
      "@type": "Organization",
      "name": "MyPathway2Global"
    },
    "publisher": {
      "@type": "Organization",
      "name": "MyPathway2Global",
      "url": "https://mypathway2global.org.uk"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://mypathway2global.org.uk{{ page.url }}"
    }
  }
  </script>
  
  {% if faqs and faqs.length %}
  <!-- FAQPage Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": {{ faq.q | dump | safe }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | dump | safe }} }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mypathway2global.org.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://mypathway2global.org.uk/blog/" },
      { "@type": "ListItem", "position": 3, "name": "{{ title }}" }
    ]
  }
  </script>
  
  <link rel="stylesheet" href="/css/styles.css?v=3">
  <link rel="stylesheet" href="/css/enhancements.css?v=8">
  <link rel="stylesheet" href="/css/blog-post.css?v=3">
</head>
<body data-page-type="blog-post">
  <a href="#main" class="skip-link">Skip to main content</a>
  
  <!-- Header -->
  <header class="header">
    <div class="header-container">
      <div class="logo">
        <a href="/" class="logo-link"><span class="logo-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18M3 12h18"/></svg></span><span class="logo-wordmark">MyPathway<span>2Global</span></span></a>
      </div>
      <nav class="navigation" aria-label="Primary">
        <button class="nav-toggle" aria-label="Toggle navigation">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav-menu">
          <li><a href="/" aria-label="Home"><svg class="nav-home-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v6a1 1 0 0 0 1 1h4v-4h2v4h4a1 1 0 0 0 1-1v-6h1a1 1 0 0 0 .707-1.707l-7-7z"/></svg></a></li>
          <li><a href="/pages/countries.html">Countries</a></li>
          <li><a href="/pages/calculator.html">Calculator</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/pages/about.html">About</a></li>
          <li><a href="/pages/find-mypathway.html" class="nav-cta">Find MyPathway</a></li>
        </ul>
      </nav>
      <button class="search-trigger" id="search-trigger" aria-label="Search (⌘K)" title="Search (⌘K)"><span class="search-trigger-icon">⎕</span><span class="search-trigger-label">Search</span><kbd>⌘K</kbd></button>
    </div>
  </header>

  <!-- Article -->
  <main id="main">
    <article class="article">
      
      <!-- Article Header -->
      <header class="article-header">
        <p class="article-meta">
          <a href="/blog/">{{ category }}</a>
          <span class="meta-sep">/</span>
          <time datetime="{{ date }}">{{ date | readableDate }}</time>
          <span class="meta-sep">/</span>
          <span>{{ readTime or (content | readingTime) }} min read</span>
        </p>
        {% if lastFactChecked %}
        <span class="badge-audit badge-audit-verified">Official Source Verified &middot; Audited: {{ lastFactChecked | readableDate }}</span>
        {% endif %}
        <h1>{{ title }}</h1>
        {% if excerpt %}
        <p class="article-lead">{{ excerpt }}</p>
        {% endif %}
      </header>

      <!-- Article Body -->
      <div class="article-body" id="article-content">
        {{ content | safe }}
      </div>

      <!-- Article Footer -->
      <footer class="article-end">
        {% if updated %}
        <p class="article-updated">Last updated {{ updated | readableDate }}</p>
        {% else %}
        <p class="article-updated">Published {{ date | readableDate }}</p>
        {% endif %}
        <p class="article-feedback">Found an error or have a tip? <a href="/pages/contact.html">Let us know</a></p>
        
        <div class="article-share">
          <span>Share:</span>
          <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url=https://mypathway2global.org.uk{{ page.url }}" target="_blank" rel="noopener">Twitter</a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://mypathway2global.org.uk{{ page.url }}" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </footer>

    </article>
  </main>

  <!-- Disclaimer -->
  <div class="disclaimer-bar">
    <p>General information only - not legal or immigration advice. Always verify current requirements with the relevant authority before paying fees or submitting an application. <a href="/pages/disclaimer.html">Full disclaimer →</a></p>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section">
        <h4>MyPathway2Global</h4>
        <p>Evidence-gated global mobility intelligence.</p>
        <p style="font-size:0.78rem;opacity:0.7;margin-top:0.5rem;">Independent platform. Not affiliated with any government.</p>
      </div>
      <div class="footer-section">
        <h4>Explore</h4>
        <ul>
          <li><a href="/pages/countries.html">Countries</a></li>
          <li><a href="/pages/find-mypathway.html">Find MyPathway</a></li>
          <li><a href="/pages/calculator.html">Calculator</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/pages/pathways-funded-study.html">Funded Routes</a></li>
          <li><a href="/pages/pathways-regional-skilled.html">Regional Routes</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Guides</h4>
        <ul>
          <li><a href="/pages/student-playbook.html">Student</a></li>
          <li><a href="/pages/professional-playbook.html">Professional</a></li>
          <li><a href="/pages/business-playbook.html">Business</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Trust</h4>
        <ul>
          <li><a href="/pages/privacy.html">Privacy</a></li>
          <li><a href="/pages/disclaimer.html">Disclaimer</a></li>
          <li><a href="/pages/terms.html">Terms</a></li>
          <li><a href="/pages/contact.html">Contact</a></li>
          <li><a href="/pages/partners.html">Partners</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 MyPathway2Global. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/app.js"></script>
  <script src="/js/search-modal.js"></script>
</body>
</html>
