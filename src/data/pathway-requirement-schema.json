  "matchingPolicy": {
    "unknownIsNotZero": true,
    "unknownIsNotPass": true,
    "noCurrencyConversionWithoutDatedExchangeRateEvidence": true,
    "noRequirementMayInheritEvidenceFromParentPathway": true,
    "countryAggregateFieldsDoNotSubstituteForPathwayRequirements": true,
    "userProfileMustNotBeTreatedAsAnEligibilityDecision": true,
    "maintenanceBalanceIsNotAnnualSpending": true,
    "salaryThresholdIsNotApplicantIncome": true
  },
  "conditionFields": {
    "applicationDateFrom": {
      "kind": "date",
      "description": "Inclusive first application date to which the requirement applies."
    },
    "applicationDateTo": {
      "kind": "date",
      "description": "Inclusive final application date to which the requirement applies."
    },
    "familySize": {
      "kind": "positive-integer",
      "description": "Number of family members including the applicant, when source guidance uses family-size tables."
    },
    "region": {
      "kind": "text",
      "description": "Region/jurisdiction scope of the value; preserve separate regional rules."
    },
    "componentsIncluded": {
      "kind": "string-array",
      "description": "Expense components represented by the amount."
    },
    "componentsExcluded": {
      "kind": "string-array",
      "description": "Expense components explicitly excluded from the amount."
    },
    "notes": {
      "kind": "text",
      "description": "Conditions, exceptions and limits needed to prevent a universal-threshold interpretation."
    }
  }
