{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globalroute",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "vrenum.app",
      "custom_domain": true
    }
  ]
}
