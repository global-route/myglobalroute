---
pagination:
  data: pathways.pathways
  size: 1
  alias: pathway
permalink: "pathways/{{ pathway.id }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ pathway.name }} — {{ pathway.sourceAuthority }} pathway intelligence, evidence status and official source trail from Global Route.">
  <title>{{ pathway.name }} | {{ pathway.countryId }} | Global Route</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header id="header" class="header">
    <div class="header-container">
      <div class="logo"><a href="/" class="logo-link"><span class="logo-icon">🌍</span><span class="logo-text">Global Route</span></a></div>
      <nav class="navigation" aria-label="Primary">
        <button class="nav-toggle" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
        <ul class="nav-menu">
          <li><a href="/">Home</a></li>
          <li><a href="/pages/countries.html">Countries</a></li>
          <li><a href="/pages/find-my-route.html">Find My Route</a></li>
          <li><a href="/pages/calculator.html">Calculator</a></li>
          <li><a href="/content/blog/">Research</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="main">
    <section class="hero">
      <div class="hero-content">
        <p><a href="/pages/countries.html">← Country directory</a></p>
        <h1>{{ pathway.name }}</h1>
        <p class="hero-subtitle">{{ pathway.countryId }} · {{ pathway.type | title }} pathway · {{ pathway.sourceAuthority }}</p>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="card">
          <h2>Evidence status</h2>
          {% if pathway.status == "publishable" %}
            <p><strong>Publishable:</strong> the pathway has passed the data publication gate.</p>
          {% else %}
            <p><strong>Research required:</strong> Global Route has not promoted this pathway to actionable guidance yet.</p>
            <p>Do not treat missing costs, approval rates or timelines as estimates. The absence of a value means it has not met the project's evidence standard.</p>
          {% endif %}
        </div>

        <div class="card">
          <h2>Official source</h2>
          <p>Authority: <strong>{{ pathway.sourceAuthority }}</strong></p>
          <p><a href="{{ pathway.sourceUrl }}" target="_blank" rel="noopener noreferrer">Open the official source →</a></p>
        </div>

        <div class="card">
          <h2>Evidence trail</h2>
          {% set pathwayEvidence = migrationEvidence.records | selectattr("pathwayId", "equalto", pathway.id) | list %}
          {% if pathwayEvidence.length %}
            <div class="evidence-list">
              {% for record in pathwayEvidence %}
                <article class="evidence-item">
                  <h3>{{ record.field | title }}</h3>
                  <p>{{ record.claim }}</p>
                  <p><strong>Authority:</strong> {{ record.sourceAuthority }} · <strong>Confidence:</strong> {{ record.confidence }}</p>
                  <p><strong>Effective:</strong> {{ record.effectiveDate }} · <strong>Retrieved:</strong> {{ record.retrievedAt }} · <strong>Review after:</strong> {{ record.reviewAfter }}</p>
                  <p><a href="{{ record.sourceUrl }}" target="_blank" rel="noopener noreferrer">Verify at source →</a></p>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <p>No field-level primary-source evidence has been attached to this pathway yet.</p>
          {% endif %}
        </div>

        <div class="card">
          <h2>What this page means</h2>
          <p>Global Route separates official facts from editorial assessment and user strategy. This page exposes the official source trail and the current evidence state; it is not a substitute for the immigration authority's current rules or professional advice.</p>
        </div>

        <div class="cta-buttons">
          <a href="/pages/find-my-route.html" class="btn btn-primary">Find My Route</a>
          <a href="/pages/disclaimer.html" class="btn btn-secondary">Read Disclaimer</a>
        </div>
      </div>
    </section>
  </main>

  <footer id="footer" class="footer"><div class="footer-content"><div class="footer-section"><h4>Global Route</h4><p>Evidence-gated global mobility intelligence.</p></div><div class="footer-section"><h4>Trust</h4><ul><li><a href="/pages/privacy.html">Privacy</a></li><li><a href="/pages/disclaimer.html">Disclaimer</a></li><li><a href="/pages/terms.html">Terms</a></li></ul></div></div><div class="footer-bottom"><p>&copy; 2026 Global Route. All rights reserved.</p></div></footer>
  <script src="/js/app.js"></script>
</body>
</html>
