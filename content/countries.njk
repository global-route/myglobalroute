---
pagination:
  data: countries.countries
  size: 1
  alias: country
permalink: "pages/countries/{{ country.id }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script async src="https://www.sabilytics.com/script.js" data-site="atsngkb78nmt" data-domain="org.uk"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ country.name }} migration intelligence: pathway status, official sources and evidence coverage from Global Route.">
  <title>{{ country.name }} Migration Intelligence | Global Route</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/enhancements.css">
  <link rel="canonical" href="https://mypathway2global.org.uk/pages/countries/{{ country.id }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mypathway2global.org.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Countries", "item": "https://mypathway2global.org.uk/pages/countries" },
      { "@type": "ListItem", "position": 3, "name": "{{ country.name }}", "item": "https://mypathway2global.org.uk/pages/countries/{{ country.id }}/" }
    ]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header id="header" class="header">
    <div class="header-container">
      <div class="logo"><a href="/" class="logo-link"><span class="logo-icon">🌍</span><span class="logo-text">Global Route</span></a></div>
      <nav class="navigation" aria-label="Primary">
        <button class="nav-toggle" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
        <ul class="nav-menu"><li><a href="/">Home</a></li><li><a href="/pages/countries.html">Countries</a></li><li><a href="/pages/find-my-route.html" class="nav-cta">Find My Route &rarr;</a></li><li><a href="/pages/calculator.html">Calculator</a></li><li><a href="/blog/">Research</a></li><li><a href="/pages/about.html">About</a></li></ul>
      </nav>
    </div>
  </header>

  <main id="main" class="main">
    <div class="page-header">
      <div class="container">
        <p style="margin-bottom:0.75rem;"><a href="/pages/countries.html" style="color:rgba(255,255,255,0.65);font-size:0.875rem;">&larr; 26-country directory</a></p>
        <h1>{{ country.flag }} {{ country.name }}</h1>
        <p class="page-header-subtitle">Evidence-gated migration intelligence &mdash; data status: <strong style="color:#fed7aa;">{{ country.dataStatus }}</strong></p>
      </div>
    </div>
    <section class="content-section"><div class="container">
      <div class="card"><h2>Country evidence status</h2>
        <p>{{ country.summary or 'Country intelligence is being verified against primary sources.' }}</p>
        <p><strong>Approval rates:</strong> {% if country.africanRate %}{{ country.africanRate }}{% else %}Not published / not verified{% endif %}</p>
        <p><strong>Planning cost:</strong> {% if country.trueCost %}{{ country.trueCost.currency }} {{ country.trueCost.total }}{% else %}Not yet verified{% endif %}</p>
        <p><strong>Timeline:</strong> {% if country.timeline %}{{ country.timeline }}{% else %}Not yet verified{% endif %}</p>
      </div>

      <div class="card"><h2>Pathways</h2>
        {% set countryPathways = pathways.pathways | selectattr("countryId", "equalto", country.id) | list %}
        {% for pathway in countryPathways %}
          <article class="evidence-item">
            <h3><a href="/pathways/{{ pathway.id }}/">{{ pathway.name }}</a></h3>
            <p>{{ pathway.type | title }} · <strong>{{ pathway.status }}</strong></p>
            {% if pathway.status == "publishable" and pathway.requirements %}
              <ul class="route-requirements">
                {% for req in pathway.requirements | slice(0, 3) %}
                  <li>{{ req.field | replace('_', ' ') | title }}: {% if req.currency %}{{ req.currency }} {% endif %}{{ req.value }}</li>
                {% endfor %}
              </ul>
              <p><a href="/pathways/{{ pathway.id }}/">Full details →</a></p>
            {% elif pathway.status == "research_required" %}
              <p class="evidence-note">{{ pathway.permanentBlocker }}</p>
            {% else %}
              <p><a href="/pathways/{{ pathway.id }}/">View pathway →</a></p>
            {% endif %}
            <p><a href="{{ pathway.sourceUrl }}" target="_blank" rel="noopener noreferrer">Official source →</a></p>
          </article>
        {% else %}
          <p>No pathway records are currently registered for this country.</p>
        {% endfor %}
      </div>

      <div class="card"><h2>Country source trail</h2>
        {% if country.source %}<p><strong>Primary authority:</strong> {{ country.source.authority }}</p><p><a href="{{ country.source.url }}" target="_blank" rel="noopener noreferrer">Open country source →</a></p>{% else %}<p>Country-level source metadata is being completed.</p>{% endif %}
        <p>This page deliberately distinguishes unavailable evidence from estimates. Verify the official authority before making an application or financial commitment.</p>
      </div>

      <div class="cta-buttons"><a href="/pages/find-my-route.html" class="btn btn-primary">Find My Route</a><a href="/pages/disclaimer.html" class="btn btn-secondary">Read Disclaimer</a></div>
    </div></section>
    <aside class="container" data-ad-slot="ad_country_mid" hidden aria-label="Advertisement"></aside>
</main>
  <footer id="footer" class="footer"><div class="footer-content"><div class="footer-section"><h4>Global Route</h4><p>Evidence-gated global mobility intelligence.</p></div><div class="footer-section"><h4>Explore</h4><ul><li><a href="/pages/countries.html">Countries</a></li><li><a href="/pages/find-my-route.html">Find My Route</a></li><li><a href="/pages/calculator.html">Calculator</a></li><li><a href="/blog/">Research</a></li></ul></div><div class="footer-section"><h4>Guides</h4><ul><li><a href="/pages/student-playbook.html">Student</a></li><li><a href="/pages/professional-playbook.html">Professional</a></li><li><a href="/pages/business-playbook.html">Business</a></li></ul></div><div class="footer-section"><h4>Trust</h4><ul><li><a href="/pages/privacy.html">Privacy</a></li><li><a href="/pages/disclaimer.html">Disclaimer</a></li><li><a href="/pages/terms.html">Terms</a></li><li><a href="/pages/contact.html">Contact</a></li></ul></div></div><div class="footer-bottom"><p>&copy; 2026 Global Route. All rights reserved.</p></div></footer>
  <script src="/js/monetization.js"></script>
  <script src="/js/analytics.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
