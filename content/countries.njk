    </div>
    <div class="footer-bottom"><p>&copy; 2026 MyPathway2Global. All rights reserved.</p></div>
  </footer>
  <script src="/js/monetization.js"></script>
  <script src="/js/analytics.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
