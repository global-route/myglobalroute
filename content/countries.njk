---
pagination:
  data: countries.countries
  size: 1
  alias: country
permalink: "pages/countries/{{ country.id }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ country.name }} migration intelligence: pathway status, official sources and evidence coverage from Global Route.">
  <title>{{ country.name }} Migration Intelligence | Global Route</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header id="header" class="header">
    <div class="header-container">
      <div class="logo"><a href="/" class="logo-link"><span class="logo-icon">🌍</span><span class="logo-text">Global Route</span></a></div>
      <nav class="navigation" aria-label="Primary">
        <button class="nav-toggle" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
        <ul class="nav-menu"><li><a href="/">Home</a></li><li><a href="/pages/countries.html">Countries</a></li><li><a href="/pages/find-my-route.html">Find My Route</a></li><li><a href="/pages/calculator.html">Calculator</a></li><li><a href="/content/blog/">Research</a></li></ul>
      </nav>
    </div>
  </header>

  <main id="main" class="main">
    <section class="hero"><div class="hero-content"><p><a href="/pages/countries.html">← 26-country directory</a></p><h1>{{ country.flag }} {{ country.name }}</h1><p class="hero-subtitle">Evidence-gated migration intelligence. Current country data status: <strong>{{ country.dataStatus }}</strong>.</p></div></section>
    <section class="content-section"><div class="container">
      <div class="card"><h2>Country evidence status</h2>
        <p>{{ country.summary or 'Country intelligence is being verified against primary sources.' }}</p>
        <p><strong>Approval rates:</strong> {% if country.africanRate %}{{ country.africanRate }}{% else %}Not published / not verified{% endif %}</p>
        <p><strong>Planning cost:</strong> {% if country.trueCost %}{{ country.trueCost.currency }} {{ country.trueCost.total }}{% else %}Not yet verified{% endif %}</p>
        <p><strong>Timeline:</strong> {% if country.timeline %}{{ country.timeline }}{% else %}Not yet verified{% endif %}</p>
      </div>

      <div class="card"><h2>Pathways</h2>
        {% set countryPathways = pathways.pathways | selectattr("countryId", "equalto", country.id) | list %}
        {% for pathway in countryPathways %}
          <article class="evidence-item">
            <h3><a href="/pathways/{{ pathway.id }}/">{{ pathway.name }}</a></h3>
            <p>{{ pathway.type | title }} · <strong>{{ pathway.status }}</strong></p>
            <p><a href="{{ pathway.sourceUrl }}" target="_blank" rel="noopener noreferrer">Official source →</a></p>
          </article>
        {% else %}
          <p>No pathway records are currently registered for this country.</p>
        {% endfor %}
      </div>

      <div class="card"><h2>Country source trail</h2>
        {% if country.source %}<p><strong>Primary authority:</strong> {{ country.source.authority }}</p><p><a href="{{ country.source.url }}" target="_blank" rel="noopener noreferrer">Open country source →</a></p>{% else %}<p>Country-level source metadata is being completed.</p>{% endif %}
        <p>This page deliberately distinguishes unavailable evidence from estimates. Verify the official authority before making an application or financial commitment.</p>
      </div>

      <div class="cta-buttons"><a href="/pages/find-my-route.html" class="btn btn-primary">Find My Route</a><a href="/pages/disclaimer.html" class="btn btn-secondary">Read Disclaimer</a></div>
    </div></section>
  </main>
  <footer id="footer" class="footer"><div class="footer-content"><div class="footer-section"><h4>Global Route</h4><p>Evidence-gated global mobility intelligence.</p></div><div class="footer-section"><h4>Trust</h4><ul><li><a href="/pages/privacy.html">Privacy</a></li><li><a href="/pages/disclaimer.html">Disclaimer</a></li><li><a href="/pages/terms.html">Terms</a></li></ul></div></div><div class="footer-bottom"><p>&copy; 2026 Global Route. All rights reserved.</p></div></footer>
  <script src="/js/app.js"></script>
</body>
</html>
